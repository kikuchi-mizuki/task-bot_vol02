{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "gunicorn -w 2 -k gthread --threads 4 -b 0.0.0.0:$PORT --access-logfile - --error-logfile - --log-level info --capture-output app:app",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 20,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "environments": {
    "production": {
      "variables": {
        "TZ": "Asia/Tokyo"
      }
    }
  }
}
